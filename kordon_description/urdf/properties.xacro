<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!--    Materials -->
    <material name="grey">
        <color rgba="0.5 0.5 0.5 1" />
    </material>

    <material name="black">
        <color rgba="1 1 1 1" />
    </material>


    <!--   Base dimensions -->
    <xacro:property name="base_length" value="0.6" />
    <xacro:property name="base_width" value="0.4" />
    <xacro:property name="base_height" value="0.2" />

    <!--   Wheel dimensions -->
    <xacro:property name="wheel_radius" value="0.1" />
    <xacro:property name="wheel_length" value="0.04" />

    <!--   Mass properties (kg) -->
    <xacro:property name="base_mass" value="12.0" />
    <xacro:property name="drive_wheel_mass" value="1.0" />
    <xacro:property name="caster_wheel_mass" value="0.4" />

    <!-- Lidar dimensions -->
    <xacro:property name="lidar_radius" value="0.05" />
    <xacro:property name="lidar_length" value="0.05" />

    <!--   Inertia helper macros -->
    <xacro:macro name="inertial_box" params="mass x y z *origin">
        <inertial>
            <xacro:insert_block name="origin" />
            <mass value="${mass}" />
            <inertia ixx="${(mass / 12.0) * (y * y + z * z)}"
                ixy="0.0"
                ixz="0.0"
                iyy="${(mass / 12.0) * (x * x + z * z)}"
                iyz="0.0"
                izz="${(mass / 12.0) * (x * x + y * y)}" />
        </inertial>
    </xacro:macro>

    <xacro:macro name="inertial_cylinder" params="mass radius length *origin">
        <inertial>
            <xacro:insert_block name="origin" />
            <mass value="${mass}" />
            <inertia ixx="${(mass / 12.0) * (3.0 * radius * radius + length * length)}"
                ixy="0.0"
                ixz="0.0"
                iyy="${0.5 * mass * radius * radius}"
                iyz="0.0"
                izz="${(mass / 12.0) * (3.0 * radius * radius + length * length)}" />
        </inertial>
    </xacro:macro>

    <xacro:macro name="inertial_sphere" params="mass radius *origin">
        <inertial>
            <xacro:insert_block name="origin" />
            <mass value="${mass}" />
            <inertia ixx="${0.4 * mass * radius * radius}"
                ixy="0.0"
                ixz="0.0"
                iyy="${0.4 * mass * radius * radius}"
                iyz="0.0"
                izz="${0.4 * mass * radius * radius}" />
        </inertial>
    </xacro:macro>

</robot>