<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="kordon_gz" params="use_gz controllers_file namespace">
        <xacro:if value="${use_gz}">
            <gazebo>
                <plugin filename="gz_ros2_control-system"
                    name="gz_ros2_control::GazeboSimROS2ControlPlugin">
                    <parameters>${controllers_file}</parameters>
                    <ros>
                        <namespace>$(arg namespace)</namespace>
                    </ros>
                </plugin>
                <plugin filename="gz-sim-odometry-publisher-system"
                    name="gz::sim::systems::OdometryPublisher">
                    <odom_frame>$(arg prefix)odom</odom_frame>
                    <robot_base_frame>$(arg prefix)base_footprint</robot_base_frame>
                    <odom_topic>$(arg odom_topic)</odom_topic>
                    <tf_topic>/tf</tf_topic>
                    <odom_publish_frequency>50</odom_publish_frequency>
                    <dimensions>2</dimensions>
                </plugin>
            </gazebo>
        </xacro:if>
    </xacro:macro>
</robot>