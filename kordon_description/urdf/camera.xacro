<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <link name="$(arg prefix)camera_link">
        <xacro:inertial_box mass="0.15" x="0.02" y="0.1" z="0.08">
            <origin xyz="0 0 0" rpy="0 0 0" />
        </xacro:inertial_box>
        <visual>
            <geometry>
                <box size="0.02 0.1 0.05" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="black" />
        </visual>
        <collision>
            <geometry>
                <box size="0.02 0.1 0.05" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>
    </link>

    <gazebo reference="$(arg prefix)camera_link">
        <sensor name="$(arg prefix)camera_sensor" type="camera">
            <topic>$(arg camera_topic)</topic>
            <always_on>true</always_on>
            <update_rate>30</update_rate>
            <visualize>true</visualize>
            <camera>
                <horizontal_fov>1.3962634</horizontal_fov>
                <image>
                    <width>1280</width>
                    <height>720</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.05</near>
                    <far>50.0</far>
                </clip>
            </camera>
        </sensor>
    </gazebo>

    <joint name="$(arg prefix)camera_joint" type="fixed">
        <parent link="$(arg prefix)base_link" />
        <child link="$(arg prefix)camera_link" />
        <origin xyz="${base_length / 2} 0 0" rpy="0 0 0" />
    </joint>
</robot>